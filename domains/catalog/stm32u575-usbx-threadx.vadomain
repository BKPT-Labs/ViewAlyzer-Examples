          87,
          88,
          89,
          90,
          91,
          92,
          93,
          94,
          96,
          97,
          98,
          99,
          112,
          113,
          114,
          115,
          116,
          117,
          118,
          119,
          120,
          121,
          122,
          123,
          128,
          129,
          130,
          144,
          145,
          146,
          147
        ]
      },
      "explain": "A sampled endpoint completion field contained a recognized error code. Inspect its named code, endpoint direction and transfer state. This is the current or most recent request field, not an active-fault flag or a complete transfer log. Repeated samples do not count repeated failures. Pending receives and ordinary thread waits are normal; reset, abort and not-ready codes are excluded.",
      "evidence": [
        "usbx.ep2.address",
        "usbx.ep2.status",
        "usbx.ep2.completion_code",
        "usbx.ep2.requested_length",
        "usbx.ep2.actual_length"
      ]
    },
    {
      "id": "usbx-control-queue-pressure",
      "name": "Control queue full or nearly full",
      "severity": "warning",
      "when": {
        "type": "ratio_below",
        "channel": "app.control_queue.available",
        "reference": "app.control_queue.capacity",
        "ratio": 0.2,
        "sustained_ms": 0
      },
      "explain": "A sample found fewer than 20% of control-message slots free. For this five-slot queue that means full. This queue carries USB start/stop messages, not CDC payload bytes. Sampling can miss brief fullness; this does not prove a dropped message or an exact occupancy peak.",
      "evidence": [
        "app.control_queue.enqueued",
        "app.control_queue.capacity",
        "app.control_queue.available",
        "app.control_queue.message_words"
      ]
    },
    {
      "id": "usbx-memory-regular-pressure",
      "name": "USBX regular memory below 10% free",
      "severity": "warning",
      "when": {
        "type": "ratio_below",
        "channel": "usbx.memory.regular.free",
        "reference": "usbx.memory.regular.total",
        "ratio": 0.1,
        "sustained_ms": 0
      },
      "explain": "A sample found less than 10% of the pool free. This is a pressure threshold, not proof of allocation failure. Free space may be fragmented and does not establish the largest available block. The cache-safe pool may alias the regular pool.",
      "evidence": [
        "usbx.memory.regular.free",
        "usbx.memory.regular.total",
        "usbx.memory.regular.fragments"
      ]
    },
    {
      "id": "usbx-memory-cache_safe-pressure",
      "name": "USBX cache-safe memory below 10% free",
      "severity": "warning",
      "when": {
        "type": "ratio_below",
        "channel": "usbx.memory.cache_safe.free",
        "reference": "usbx.memory.cache_safe.total",
        "ratio": 0.1,
        "sustained_ms": 0
      },
      "explain": "A sample found less than 10% of the pool free. This is a pressure threshold, not proof of allocation failure. Free space may be fragmented and does not establish the largest available block. The cache-safe pool may alias the regular pool.",
      "evidence": [
        "usbx.memory.cache_safe.free",
        "usbx.memory.cache_safe.total",
        "usbx.memory.cache_safe.fragments"
      ]
    }
  ],
  "presentation": {
    "sections": [
      {
        "title": "Errors and buffer health",
        "view": "table",
        "description": "Reported errors may predate this session and persist after recovery. Zero reports is not proof that all API calls succeeded. Observed incidents below remain visible after recovery.",
        "fields": [
          {
            "channel": "usbx.last_error",
            "label": "Last reported stack error"
          },
          {
            "channel": "usbx.error_count",
            "label": "Reported errors since stack init",
            "unit": "reports"
          },
          {
            "channel": "app.control_queue.enqueued",
            "reference": "app.control_queue.capacity",
            "label": "USB start/stop control queue",
            "unit": "messages"
          },
          {
            "channel": "usbx.memory.regular.free",
            "reference": "usbx.memory.regular.total",
            "label": "USBX regular memory free",
            "unit": "bytes"
          },
          {
            "channel": "usbx.memory.cache_safe.free",
            "reference": "usbx.memory.cache_safe.total",
            "label": "USBX cache-safe memory free",
            "unit": "bytes"
          }
        ],
        "checks": [
          "usbx-error-reports",
          "usbx-ep1-completion",
          "usbx-ep2-completion",
          "usbx-control-queue-pressure",
          "usbx-memory-regular-pressure",
          "usbx-memory-cache_safe-pressure"
        ]
      },
      {
        "title": "USB controller",
        "view": "cards",
        "description": "Sampled controller state; brief changes between reads can be missed.",
        "fields": [
          {
            "channel": "usb.interrupts_enabled",
            "label": "Interrupt delivery"
          },
          {
            "channel": "usb.soft_disconnect",
            "label": "Software connection"
          },
          {
            "channel": "usb.address",
            "label": "USB address"
          },
          {
            "channel": "usb.suspended",
            "label": "Bus state"
          }
        ]
      },
      {
        "title": "USBX device and CDC class",
        "view": "cards",
        "description": "Current device and host settings. Uninitialized or changing objects are shown as unavailable.",
        "fields": [
          {
            "channel": "usbx.device_state",
            "label": "USBX state"
          },
          {
            "channel": "usbx.configuration",
            "label": "Selected configuration"
          },
          {
            "channel": "usbx.baud",
            "label": "CDC baud rate"
          },
          {
            "channel": "usbx.dtr",
            "label": "Host DTR"
          },
          {
            "channel": "usbx.rts",
            "label": "Host RTS"
          }
        ]
      },
      {
        "title": "CDC endpoint 1",
        "view": "table",
        "description": "Current or most recent request. Fields are sampled separately; these lengths do not measure throughput.",
        "fields": [
          {
            "channel": "usbx.ep1.address",
            "label": "Endpoint / direction"
          },
          {
            "channel": "usbx.ep1.status",
            "label": "Transfer state"
          },
          {
            "channel": "usbx.ep1.requested_length",
            "label": "Requested bytes"
          },
          {
            "channel": "usbx.ep1.actual_length",
            "label": "Actual bytes"
          },
          {
            "channel": "usbx.ep1.completion_code",
            "label": "Completion code"
          }
        ]
      },
      {
        "title": "CDC endpoint 2",
        "view": "table",
        "description": "Current or most recent request. Fields are sampled separately; these lengths do not measure throughput.",
        "fields": [
          {
            "channel": "usbx.ep2.address",
            "label": "Endpoint / direction"
          },
          {
            "channel": "usbx.ep2.status",
            "label": "Transfer state"
          },
          {
            "channel": "usbx.ep2.requested_length",
            "label": "Requested bytes"
          },
          {
            "channel": "usbx.ep2.actual_length",
            "label": "Actual bytes"
          },
          {
            "channel": "usbx.ep2.completion_code",
            "label": "Completion code"
          }
        ]
      },
      {
        "title": "Application and ThreadX",
        "view": "table",
        "description": "Waiting is normal at idle. Compare the producer and consumer indices with endpoint demand.",
        "fields": [
          {
            "channel": "threadx.read_state",
            "label": "CDC read thread"
          },
          {
            "channel": "threadx.write_state",
            "label": "CDC write thread"
          },
          {
            "channel": "app.tx_in",
            "label": "UART producer index"
          },
          {
            "channel": "app.tx_out",
            "label": "USB consumer index"
          }
        ]
      },
      {
        "title": "Queue and allocator details",
        "view": "table",
        "description": "The control queue is separate from the UART/CDC payload ring. Bare ring indices cannot establish overflow or lost bytes. Allocator minimum-free and queue full/timeout statistics are not enabled in the example firmware. The two USBX pools may share storage; do not add their sizes.",
        "fields": [
          {
            "channel": "app.control_queue.message_words",
            "label": "Control message size",
            "unit": "32-bit words"
          },
          {
            "channel": "app.control_queue.available",
            "label": "Control queue free slots",
            "unit": "slots"
          },
          {
            "channel": "app.control_queue.waiters",
            "label": "Threads waiting on control queue"
          },
          {
            "channel": "usbx.memory.regular.fragments",
            "label": "Regular pool fragments"
          },
          {
            "channel": "usbx.memory.cache_safe.fragments",
            "label": "Cache-safe pool fragments"
          }
        ]
      }
    ]
  }
}
