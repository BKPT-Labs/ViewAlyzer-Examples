      "source": "eth.mac_debug",
      "shift": 17,
      "mask": "0x3",
      "values": {
        "0": "IDLE",
        "1": "WAITING",
        "2": "PAUSE",
        "3": "TRANSFERRING"
      }
    },
    {
      "type": "field",
      "name": "eth.mac_rx_state",
      "source": "eth.mac_debug",
      "shift": 1,
      "mask": "0x3",
      "values": {
        "0": "IDLE",
        "1": "READING",
        "2": "STATUS",
        "3": "FLUSHING"
      }
    },
    {
      "type": "field",
      "name": "eth.txq_read_state",
      "source": "eth.mtl_txq_dbg",
      "shift": 1,
      "mask": "0x3",
      "values": {
        "0": "IDLE",
        "1": "READ",
        "2": "WAITING",
        "3": "FLUSHING"
      }
    },
    {
      "type": "field",
      "name": "eth.rxq_read_state",
      "source": "eth.mtl_rxq_dbg",
      "shift": 1,
      "mask": "0x3",
      "values": {
        "0": "IDLE",
        "1": "READING",
        "2": "STATUS",
        "3": "FLUSHING"
      }
    },
    {
      "type": "field",
      "name": "eth.rxq_fill",
      "source": "eth.mtl_rxq_dbg",
      "shift": 4,
      "mask": "0x3",
      "values": {
        "0": "EMPTY",
        "1": "BELOW_THRESH",
        "2": "ABOVE_THRESH",
        "3": "FULL"
      }
    },
    {
      "type": "field",
      "name": "eth.rxq_packets",
      "source": "eth.mtl_rxq_dbg",
      "shift": 16,
      "mask": "0x3FFF"
    },
    {
      "type": "field",
      "name": "eth.rx_missed_frames",
      "source": "eth.rx_missed",
      "shift": 16,
      "mask": "0x7FF"
    },
    {
      "type": "field",
      "name": "eth.rx_fifo_overflow",
      "source": "eth.rx_missed",
      "shift": 0,
      "mask": "0x7FF"
    },
    {
      "type": "field",
      "name": "eth.dma_missed_frames",
      "source": "eth.dma_missed",
      "shift": 0,
      "mask": "0x7FF"
    }
  ],
  "presentation": {
    "sections": [
      {
        "title": "Traffic",
        "view": "cards",
        "description": "MAC counter observations and derived rates. Host polling can miss brief state transitions.",
        "fields": [
          {
            "channel": "eth.rx_rate",
            "label": "MAC receive rate",
            "unit": "pkts/s"
          },
          {
            "channel": "eth.tx_rate",
            "label": "MAC transmit rate",
            "unit": "pkts/s"
          },
          {
            "channel": "eth.rx_good",
            "label": "Received good frames"
          },
          {
            "channel": "eth.tx_good",
            "label": "Transmitted good frames"
          }
        ],
        "checks": [
          "rx-stopped"
        ]
      },
      {
        "title": "Receive path",
        "view": "table",
        "description": "Descriptor occupancy and queue/state snapshots describe the instant sampled. A brief stall can occur between observations.",
        "fields": [
          {
            "channel": "eth.rx_ring",
            "label": "Descriptors awaiting the application",
            "unit": "desc"
          },
          {
            "channel": "eth.rxq_packets",
            "label": "Queued receive packets",
            "unit": "pkts"
          },
          {
            "channel": "eth.rxq_fill",
            "label": "Receive queue fill state"
          },
          {
            "channel": "eth.rx_dma_state",
            "label": "Receive DMA state",
            "group": [
              "DMA"
            ]
          },
          {
            "channel": "eth.rx_ring_cur",
            "label": "Current receive descriptor address",
            "group": [
              "DMA"
            ]
          },
          {
            "channel": "eth.rxq_read_state",
            "label": "Receive queue read state",
            "group": [
              "Queue"
            ]
          },
          {
            "channel": "eth.mac_rx_state",
            "label": "MAC receive state",
            "group": [
              "MAC"
            ]
          }
        ],
        "checks": [
          "rx-ring-saturated"
        ]
      },
      {
        "title": "Transmit path",
        "view": "table",
        "description": "Decoded controller states from the sampled status registers.",
        "fields": [
          {
            "channel": "eth.tx_dma_state",
            "label": "Transmit DMA state"
          },
          {
            "channel": "eth.txq_read_state",
            "label": "Transmit queue read state"
          },
          {
            "channel": "eth.mac_tx_state",
            "label": "MAC transmit state"
          }
        ]
      },
      {
        "title": "Errors and drops",
        "view": "table",
        "description": "Missed-frame and overflow fields come from consuming counters and describe read intervals. CRC/alignment and stack drops are cumulative.",
        "fields": [
          {
            "channel": "eth.rx_crc_err",
            "label": "CRC errors",
            "group": [
              "Wire"
            ]
          },
          {
            "channel": "eth.rx_align_err",
            "label": "Alignment errors",
            "group": [
              "Wire"
            ]
          },
          {
            "channel": "eth.rx_missed_frames",
            "label": "Frames missed in this read interval",
            "group": [
              "Receive"
            ]
          },
          {
            "channel": "eth.rx_fifo_overflow",
            "label": "FIFO overflow count in this read interval",
            "group": [
              "Receive"
            ]
          },
          {
            "channel": "eth.dma_missed_frames",
            "label": "DMA misses in this read interval",
            "group": [
              "DMA"
            ]
          },
          {
            "channel": "lwip.ip_drop",
            "label": "IP packets dropped",
            "group": [
              "Stack"
            ]
          },
          {
            "channel": "lwip.udp_drop",
            "label": "UDP datagrams dropped",
            "group": [
              "Stack"
            ]
          }
        ],
        "checks": [
          "rx-frames-missed",
          "rx-crc-errors",
          "rx-fifo-overflow",
          "stack-dropping"
        ]
      },
      {
        "title": "Network stack",
        "view": "table",
        "description": "Application-owned lwIP counters. Offsets and widths must match this exact N6 demo ELF and its lwIP configuration.",
        "fields": [
          {
            "channel": "lwip.ip_recv",
            "label": "IP packets accepted"
          },
          {
            "channel": "lwip.udp_recv",
            "label": "UDP datagrams accepted"
          },
          {
            "channel": "lwip.mem_used",
            "label": "Heap bytes in use",
            "unit": "B"
          }
        ],
        "checks": [
          "app-not-draining"
        ]
      },
      {
        "title": "Raw registers and access limits",
        "view": "table",
        "description": "Registers, addresses and packed fields are kept out of graphs by default. PHY MDIO access remains unsafe and unavailable; grouping does not authorize a read.",
        "fields": [
          {
            "channel": "eth.mmc_control",
            "label": "MMC control",
            "group": [
              "MAC"
            ]
          },
          {
            "channel": "eth.mac_config",
            "label": "MAC configuration",
            "group": [
              "MAC"
            ]
          },
          {
            "channel": "eth.mac_debug",
            "label": "MAC debug",
            "group": [
              "MAC"
            ]
          },
          {
            "channel": "eth.mtl_txq_dbg",
            "label": "Transmit queue debug",
            "group": [
              "Queues"
            ]
          },
          {
            "channel": "eth.mtl_rxq_dbg",
            "label": "Receive queue debug",
            "group": [
              "Queues"
            ]
          },
          {
            "channel": "eth.rx_missed",
            "label": "Packed MTL missed/overflow sample",
            "group": [
              "Consuming counters"
            ]
          },
          {
            "channel": "eth.dma_missed",
            "label": "Packed DMA missed sample",
            "group": [
              "Consuming counters"
            ]
          },
          {
            "channel": "eth.dma_debug",
            "label": "DMA debug",
            "group": [
              "DMA"
            ]
          },
          {
            "channel": "eth.dma_ch0",
            "label": "DMA channel status",
            "group": [
              "DMA"
            ]
          },
          {
            "channel": "eth.phy_link",
            "label": "PHY link access (not sampled)",
            "group": [
              "Access limits"
            ]
          }
        ]
      }
    ]
  }
}
