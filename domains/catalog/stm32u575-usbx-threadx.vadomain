{
  "id": "com.bkpt.stm32u575.usbx-cdc-threadx",
  "name": "STM32U575 USBX CDC ACM on ThreadX",
  "version": "0.3.0",
  "domain_api": 1,
  "publisher": "BKPT Labs",
  "sampled_state": {
    "svd_device": "STM32U575",
    "target_device_prefix": [
      "STM32U575"
    ],
    "rate_hz": 20,
    "ram_read_groups": [
      {
        "id": "usb-device",
        "channels": [
          "usbx.device_state",
          "usbx.configuration"
        ],
        "max_bytes": 160,
        "allow_padding": true
      },
      {
        "id": "cdc-control",
        "channels": [
          "usbx.baud",
          "usbx.dtr",
          "usbx.rts"
        ],
        "max_bytes": 16,
        "allow_padding": true
      },
      {
        "id": "endpoint-1",
        "channels": [
          "usbx.ep1.address",
          "usbx.ep1.status",
          "usbx.ep1.requested_length",
          "usbx.ep1.actual_length",
          "usbx.ep1.completion_code"
        ],
        "max_bytes": 64,
        "allow_padding": true
      },
      {
        "id": "endpoint-2",
        "channels": [
          "usbx.ep2.address",
          "usbx.ep2.status",
          "usbx.ep2.requested_length",
          "usbx.ep2.actual_length",
          "usbx.ep2.completion_code"
        ],
        "max_bytes": 64,
        "allow_padding": true
      },
      {
        "id": "stack-errors",
        "channels": [
          "usbx.last_error",
          "usbx.error_count"
        ],
        "max_bytes": 8,
        "allow_padding": false
      },
      {
        "id": "control-queue",
        "channels": [
          "app.control_queue.enqueued",
          "app.control_queue.capacity",
          "app.control_queue.available",
          "app.control_queue.message_words",
          "app.control_queue.waiters"
        ],
        "max_bytes": 40,
        "allow_padding": true
      },
      {
        "id": "memory-regular",
        "channels": [
          "usbx.memory.regular.free",
          "usbx.memory.regular.total",
          "usbx.memory.regular.fragments"
        ],
        "max_bytes": 20,
        "allow_padding": true
      },
      {
        "id": "memory-cache_safe",
        "channels": [
          "usbx.memory.cache_safe.free",
          "usbx.memory.cache_safe.total",
          "usbx.memory.cache_safe.fragments"
        ],
        "max_bytes": 20,
        "allow_padding": true
      }
    ],
    "channels": [
      {
        "name": "usb.gahbcfg",
        "peripheral": "OTG_FS",
        "register": "GAHBCFG",
        "ty": "u32",
        "safety": "read-safe",
        "note": "STM32U575 OTG_FS configuration/status. Reading does not acknowledge interrupts.",
        "precondition": {
          "peripheral": "RCC",
          "register": "RCC_AHB2ENR1",
          "mask": "0x4000",
          "equals": "0x4000",
          "description": "The USB OTG peripheral clock must be enabled (RCC OTGEN)."
        }
      },
      {
        "name": "usb.dctl",
        "peripheral": "OTG_FS",
        "register": "DCTL",
        "ty": "u32",
        "safety": "read-safe",
        "note": "STM32U575 OTG_FS configuration/status. Reading does not acknowledge interrupts.",
        "precondition": {
          "peripheral": "RCC",
          "register": "RCC_AHB2ENR1",
          "mask": "0x4000",
          "equals": "0x4000",
          "description": "The USB OTG peripheral clock must be enabled (RCC OTGEN)."
        }
      },
      {
        "name": "usb.dsts",
        "peripheral": "OTG_FS",
        "register": "DSTS",
        "ty": "u32",
        "safety": "read-safe",
        "note": "STM32U575 OTG_FS configuration/status. Reading does not acknowledge interrupts.",
        "precondition": {
          "peripheral": "RCC",
          "register": "RCC_AHB2ENR1",
          "mask": "0x4000",
          "equals": "0x4000",
          "description": "The USB OTG peripheral clock must be enabled (RCC OTGEN)."
        }
      },
      {
        "name": "usb.dcfg",
        "peripheral": "OTG_FS",
        "register": "DCFG",
        "ty": "u32",
        "safety": "read-safe",
        "note": "STM32U575 OTG_FS configuration/status. Reading does not acknowledge interrupts.",
        "precondition": {
          "peripheral": "RCC",
          "register": "RCC_AHB2ENR1",
          "mask": "0x4000",
          "equals": "0x4000",
          "description": "The USB OTG peripheral clock must be enabled (RCC OTGEN)."
        }
      },
      {
        "name": "usb.gintmsk",
        "peripheral": "OTG_FS",
        "register": "GINTMSK",
        "ty": "u32",
        "safety": "read-safe",
        "note": "STM32U575 OTG_FS configuration/status. Reading does not acknowledge interrupts.",
        "precondition": {
          "peripheral": "RCC",
          "register": "RCC_AHB2ENR1",
          "mask": "0x4000",
          "equals": "0x4000",
          "description": "The USB OTG peripheral clock must be enabled (RCC OTGEN)."
        }
      },
