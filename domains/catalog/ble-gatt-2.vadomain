  "verdicts": [],
  "presentation": {
    "sections": [
      {
        "title": "Characteristic slot 2",
        "view": "table",
        "description": "Present=0 means unused. Handles, UUIDs and properties come from successful registration. Value origin=0 means no observed value. Payload is the retained 16-byte prefix in four little-endian words. Values and counters are application observations; update success does not prove client receipt. CCCD is for the single current connection.",
        "fields": [
          {
            "channel": "ble.characteristics.2.present",
            "label": "Present"
          },
          {
            "channel": "ble.characteristics.2.service",
            "label": "Parent service handle"
          },
          {
            "channel": "ble.characteristics.2.declaration",
            "label": "Characteristic declaration handle",
            "group": [
              "Identity"
            ]
          },
          {
            "channel": "ble.characteristics.2.value_handle",
            "label": "Value handle",
            "group": [
              "Identity"
            ]
          },
          {
            "channel": "ble.characteristics.2.cccd_handle",
            "label": "CCCD handle (0 = none)",
            "group": [
              "Identity"
            ]
          },
          {
            "channel": "ble.characteristics.2.uuid_type",
            "label": "UUID type",
            "group": [
              "Identity"
            ]
          },
          {
            "channel": "ble.characteristics.2.properties",
            "label": "Property bitmask",
            "group": [
              "Properties"
            ]
          },
          {
            "channel": "ble.characteristics.2.max_length",
            "label": "Maximum value bytes",
            "group": [
              "Value"
            ]
          },
          {
            "channel": "ble.characteristics.2.length",
            "label": "Last observed payload bytes",
            "group": [
              "Value"
            ]
          },
          {
            "channel": "ble.characteristics.2.captured",
            "label": "Retained prefix bytes",
            "group": [
              "Value"
            ]
          },
          {
            "channel": "ble.characteristics.2.value_origin",
            "label": "Value source",
            "group": [
              "Value"
            ]
          },
          {
            "channel": "ble.characteristics.2.cccd",
            "label": "Client subscription",
            "group": [
              "Subscription"
            ]
          },
          {
            "channel": "ble.characteristics.2.writes",
            "label": "Remote value writes observed",
            "group": [
              "Activity"
            ]
          },
          {
            "channel": "ble.characteristics.2.updates",
            "label": "Local update requests",
            "group": [
              "Activity"
            ]
          },
          {
            "channel": "ble.characteristics.2.update_ok",
            "label": "Local updates accepted",
            "group": [
              "Activity"
            ]
          },
          {
            "channel": "ble.characteristics.2.last_status",
            "label": "Last local update status",
            "group": [
              "Activity"
            ]
          },
