{
  "id": "com.bkpt.stm32-ethernet",
  "name": "STM32 Ethernet",
  "version": "0.9.0",
  "domain_api": 1,
  "publisher": "BKPT Labs",
  "sampled_state": {
    "svd_device": "STM32N657",
    "target_device_prefix": [
      "STM32N65"
    ],
    "rate_hz": 100,
    "channels": [
      {
        "name": "eth.tx_good",
        "peripheral": "ETH_S",
        "register": "ETH_TX_PACKET_COUNT_GOOD",
        "note": "monotonic; valid while MMC_CONTROL.RSTONRD is clear (ST HAL default)",
        "precondition": {
          "peripheral": "ETH_S",
          "register": "ETH_MMC_CONTROL",
          "mask": "0x4",
          "equals": "0x0",
          "description": "MMC_CONTROL.RSTONRD is set: counter reads self-clear, sampling would destroy the values it reports"
        },
        "counter": "wrapping"
      },
      {
        "name": "eth.rx_good",
        "peripheral": "ETH_S",
        "register": "ETH_RX_UNICAST_PACKETS_GOOD",
        "note": "unicast only; broadcast/multicast are separate MMC counters",
        "precondition": {
          "peripheral": "ETH_S",
          "register": "ETH_MMC_CONTROL",
          "mask": "0x4",
          "equals": "0x0",
          "description": "MMC_CONTROL.RSTONRD is set: counter reads self-clear, sampling would destroy the values it reports"
        },
        "counter": "wrapping"
      },
      {
        "name": "eth.rx_crc_err",
        "peripheral": "ETH_S",
        "register": "ETH_RX_CRC_ERROR_PACKETS",
        "precondition": {
          "peripheral": "ETH_S",
          "register": "ETH_MMC_CONTROL",
          "mask": "0x4",
          "equals": "0x0",
          "description": "MMC_CONTROL.RSTONRD is set: counter reads self-clear, sampling would destroy the values it reports"
        },
        "counter": "wrapping"
      },
      {
        "name": "eth.rx_align_err",
        "peripheral": "ETH_S",
        "register": "ETH_RX_ALIGNMENT_ERROR_PACKETS",
        "precondition": {
          "peripheral": "ETH_S",
          "register": "ETH_MMC_CONTROL",
          "mask": "0x4",
          "equals": "0x0",
          "description": "MMC_CONTROL.RSTONRD is set: counter reads self-clear, sampling would destroy the values it reports"
        },
        "counter": "wrapping"
      },
      {
        "name": "eth.mmc_control",
        "peripheral": "ETH_S",
        "register": "ETH_MMC_CONTROL",
        "note": "RSTONRD (bit 2) set would make counter reads self-clear"
      },
      {
        "name": "eth.mac_config",
        "peripheral": "ETH_S",
        "register": "ETH_MACCR",
        "note": "link speed/duplex as programmed by the driver; RE/TE enable bits"
      },
      {
        "name": "eth.mac_debug",
        "peripheral": "ETH_S",
        "register": "ETH_MACDR",
        "note": "MAC tx/rx FSM states, read-only"
      },
      {
        "name": "eth.mtl_txq_dbg",
        "peripheral": "ETH_S",
        "register": "ETH_MTLTXQ0DR",
        "note": "tx queue fill and controller state"
      },
      {
        "name": "eth.mtl_rxq_dbg",
        "peripheral": "ETH_S",
        "register": "ETH_MTLRXQ0DR",
        "note": "rx queue fill level"
      },
      {
        "name": "eth.rx_missed",
        "peripheral": "ETH_S",
        "register": "ETH_MTLRXQ0MPOCR",
        "note": "missed packet and fifo overflow counters; CLEAR-ON-READ: each sample is the count since the previous read, not a running total, and a debug-port read consumes counts any firmware reader would have seen",
        "counter": "clear_on_read"
      },
      {
        "name": "eth.dma_debug",
        "peripheral": "ETH_S",
        "register": "ETH_DMADSR",
        "note": "rx/tx DMA process states; suspended/stopped verdicts derive from this"
      },
      {
        "name": "eth.dma_ch0",
        "peripheral": "ETH_S",
        "register": "ETH_DMAC0SR",
        "note": "channel status bits clear on write-1, never on read"
      },
      {
        "name": "eth.rx_ring_cur",
        "peripheral": "ETH_S",
        "register": "ETH_DMAC0CARXDR",
        "note": "current rx descriptor pointer: the ring occupancy cursor"
      },
      {
        "name": "eth.dma_missed",
        "peripheral": "ETH_S",
        "register": "ETH_DMAC0MFCR",
        "counter": "clear_on_read"
      },
      {
        "name": "eth.phy_link",
        "safety": "unsafe",
        "reason": "PHY registers go through MDIO (MACMDIOAR/MACMDIODR) and a debug-port transaction races the driver's own use of the address register; link speed is shown from ETH_MACCR instead"
      },
      {
        "name": "eth.rx_ring",
        "ring": {
          "symbol": "DMARxDscrTab",
          "entries": 4,
          "stride_bytes": 24,
          "own_word_offset": 12,
          "own_mask": "0x80000000",
          "count_set": false
        },
        "note": "ch0 RX descriptor ring backlog: descriptors filled by the DMA and not yet reclaimed by the application"
      },
      {
        "name": "lwip.ip_recv",
        "symbol": "lwip_stats",
        "offset_bytes": 74,
        "ty": "u16",
        "counter": "wrapping",
        "note": "packets the stack delivered to IP; lwIP's own statistics block (LWIP_STATS in lwipopts.h); nothing is added to the firmware to observe it. STAT_COUNTER is u16 here (LWIP_STATS_LARGE off) so it wraps every few seconds under load and is declared wrapping. Cacheable AXISRAM: reads can lag the core by write-back timing"
      },
      {
        "name": "lwip.ip_drop",
        "symbol": "lwip_stats",
        "offset_bytes": 78,
        "ty": "u16",
        "counter": "wrapping",
        "note": "packets IP dropped; lwIP's own statistics block (LWIP_STATS in lwipopts.h); nothing is added to the firmware to observe it. STAT_COUNTER is u16 here (LWIP_STATS_LARGE off) so it wraps every few seconds under load and is declared wrapping. Cacheable AXISRAM: reads can lag the core by write-back timing"
      },
      {
        "name": "lwip.udp_recv",
        "symbol": "lwip_stats",
        "offset_bytes": 122,
        "ty": "u16",
        "counter": "wrapping",
        "note": "datagrams delivered to UDP; lwIP's own statistics block (LWIP_STATS in lwipopts.h); nothing is added to the firmware to observe it. STAT_COUNTER is u16 here (LWIP_STATS_LARGE off) so it wraps every few seconds under load and is declared wrapping. Cacheable AXISRAM: reads can lag the core by write-back timing"
      },
      {
        "name": "lwip.udp_drop",
        "symbol": "lwip_stats",
        "offset_bytes": 126,
        "ty": "u16",
        "counter": "wrapping",
        "note": "datagrams UDP dropped (no PCB, or the receive queue is full); lwIP's own statistics block (LWIP_STATS in lwipopts.h); nothing is added to the firmware to observe it. STAT_COUNTER is u16 here (LWIP_STATS_LARGE off) so it wraps every few seconds under load and is declared wrapping. Cacheable AXISRAM: reads can lag the core by write-back timing"
      },
      {
        "name": "lwip.mem_used",
        "symbol": "lwip_stats",
        "offset_bytes": 172,
        "ty": "u16",
        "note": "heap bytes in use right now (a level, not a counter); lwIP's own statistics block (LWIP_STATS in lwipopts.h); nothing is added to the firmware to observe it. STAT_COUNTER is u16 here (LWIP_STATS_LARGE off) so it wraps every few seconds under load and is declared wrapping. Cacheable AXISRAM: reads can lag the core by write-back timing"
      }
    ],
    "coalesce_gap_bytes": 128,
    "precondition": {
      "peripheral": "RCC_S",
      "register": "RCC_AHB5ENR",
      "mask": "0x02000000",
      "equals": "0x02000000",
      "description": "ETH1 clock disabled (RCC_AHB5ENR.ETH1EN clear): the block is unclocked and reads return zeros, not data"
    }
  },
  "channels": [
    {
