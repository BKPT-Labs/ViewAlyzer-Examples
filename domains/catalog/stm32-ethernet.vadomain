  "series_kinds": [],
  "namespaces": [],
  "verdicts": [
    {
      "id": "app-not-draining",
      "name": "Application not draining",
      "severity": "warning",
      "when": {
        "type": "counter_stalled",
        "channel": "lwip.ip_recv",
        "while_advances": "eth.rx_good",
        "window_ms": 250,
        "min_advance": 50
      },
      "explain": "Frames kept arriving at the MAC while the stack stopped accepting them: the receive path (driver task, buffer pool, or the consumer of the data) is not keeping up, so descriptors are never handed back to the DMA. Check whether the consumer task is running and whether the RX buffer pool is exhausted by unread data queued on sockets. Detected from counters rather than from ring occupancy: a stall shorter than the poll interval never appears in an instantaneous level, but both counters still record it.",
      "evidence": [
        "lwip.ip_recv",
        "eth.rx_good",
        "eth.rx_ring",
        "eth.rx_dma_state",
        "eth.rx_missed_frames",
        "lwip.mem_used"
      ]
    },
    {
      "id": "rx-frames-missed",
      "name": "RX frames missed by the MAC",
      "severity": "error",
      "when": {
        "type": "value_at_or_above",
        "channel": "eth.rx_missed_frames",
        "value": 1
      },
      "explain": "The MAC dropped incoming frames because no descriptor was available. This is packet LOSS on the receive side, downstream of a ring the application is not draining. The value is frames lost within one poll interval (MTLRXQ0MPOCR.MISPKTCNT is clear-on-read), not a running total.",
      "evidence": [
        "eth.rx_missed_frames",
        "eth.rx_fifo_overflow",
        "eth.rx_ring",
        "eth.rx_dma_state",
        "lwip.ip_recv"
      ]
    },
    {
      "id": "rx-crc-errors",
      "name": "CRC errors on the wire",
      "severity": "error",
      "when": {
        "type": "counter_advanced",
        "channel": "eth.rx_crc_err"
      },
      "explain": "Frames arrived with bad checksums: physical-layer trouble (cable, connector, PHY negotiation, EMI), not a software problem.",
      "evidence": [
        "eth.rx_crc_err",
        "eth.rx_align_err",
        "eth.mac_config"
      ]
    },
    {
      "id": "rx-stopped",
      "name": "RX stopped while TX continues",
      "severity": "warning",
      "when": {
        "type": "counter_stalled",
        "channel": "eth.rx_good",
        "while_advances": "eth.tx_good",
        "window_ms": 1000
      },
      "explain": "The MAC keeps transmitting but nothing is being received. Suspect the receive path specifically: RX DMA state, buffer availability, or the peer no longer sending.",
      "evidence": [
        "eth.rx_rate",
        "eth.tx_rate",
        "eth.rx_dma_state",
        "eth.tx_dma_state"
      ]
    },
    {
      "id": "rx-fifo-overflow",
      "name": "RX FIFO overflowed",
      "severity": "error",
      "when": {
        "type": "value_at_or_above",
        "channel": "eth.rx_fifo_overflow",
        "value": 1
      },
      "explain": "Frames were lost inside the MAC's receive FIFO: the MTL queue filled faster than the DMA drained it into memory. Unlike missed frames (no descriptor), this points at bus/DMA throughput or a burst above what the queue depth absorbs. Value is frames lost in one poll interval (clear-on-read).",
      "evidence": [
        "eth.rx_fifo_overflow",
        "eth.rxq_fill",
        "eth.rxq_packets",
        "eth.rx_missed_frames",
        "eth.rx_ring"
      ]
    },
    {
      "id": "rx-ring-saturated",
      "name": "RX descriptor ring saturated",
      "severity": "suspicious",
      "when": {
        "type": "sustained_at_or_above",
        "channel": "eth.rx_ring",
        "value": 3,
        "sustained_ms": 100
      },
      "explain": "The RX descriptor ring stayed full: descriptors are filled by the DMA and not reclaimed. Only visible when the stall lasts longer than the poll interval, so its absence proves nothing - read it as confirmation when it does fire.",
      "evidence": [
        "eth.rx_ring",
        "eth.rx_ring_cur",
        "eth.rx_dma_state",
        "eth.rx_missed_frames"
      ]
    },
    {
      "id": "stack-dropping",
      "name": "Datagrams dropped by the stack",
      "severity": "warning",
      "when": {
        "type": "counter_advanced",
        "channel": "lwip.udp_drop"
      },
      "explain": "The stack received datagrams and threw them away: no PCB is bound for that port, or the receive queue of a socket nobody is reading is full. Loss above the MAC, so the Ethernet counters stay clean.",
      "evidence": [
        "lwip.udp_drop",
        "lwip.udp_recv",
        "lwip.mem_used",
        "eth.rx_good"
      ]
    }
  ],
  "derived": [
    {
      "type": "field",
      "name": "eth.rx_dma_state",
      "source": "eth.dma_debug",
      "shift": 8,
      "mask": "0xF",
      "values": {
        "0": "STOPPED",
        "1": "FETCHING",
        "3": "WAITING",
        "4": "SUSPENDED",
        "5": "CLOSING",
        "6": "TIMESTAMP_WR",
        "7": "TRANSFERRING"
      }
    },
    {
      "type": "field",
      "name": "eth.tx_dma_state",
      "source": "eth.dma_debug",
      "shift": 12,
      "mask": "0xF",
      "values": {
        "0": "STOPPED",
        "1": "FETCHING",
        "2": "WAITING",
        "3": "READING",
        "4": "TIMESTAMP_WR",
        "6": "SUSPENDED",
        "7": "CLOSING"
      }
    },
    {
      "type": "rate",
      "name": "eth.rx_rate",
      "source": "eth.rx_good",
      "unit": "pkts/s"
    },
    {
      "type": "rate",
