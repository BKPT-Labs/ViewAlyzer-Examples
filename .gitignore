# Build output (per-board / per-transport build dirs)
build/
build-*/
bkpt-build/
CMakeFiles/
CMakeCache.txt
CMakeUserPresets.json
.cmake/
build.ninja
.ninja_deps
.ninja_log
cmake_install.cmake
compile_commands.json

# Zephyr module discovery output from an accidental in-source configure
/zephyr/*/Kconfig/Kconfig.modules
/zephyr/*/Kconfig/Kconfig.sysbuild.modules
/zephyr/*/sysbuild_modules.txt
/zephyr/*/zephyr_modules.txt
/zephyr/*/zephyr_settings.txt

# Python
__pycache__/
*.pyc

# Per-machine tool paths (see tools.local.example.json)
build.local.json
build.local.*.json
tools.local.json
tools.local.*.json
!tools.local.example.json

# Editor / tool caches
.gitnexus/
.vscode/
.bkpt/
.cache/
.root-artifact-backup/

# ViewAlyzer per-machine state (shared .va/settings.json IS committed)
.va/settings.local.*.json
.va/locks/
.va/trace/
.va/debug-audit.ndjson

# Capture databases (outputs, not sources)
*.vadb
