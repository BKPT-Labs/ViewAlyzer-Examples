{
  "comment": "Nucleo-C071RB (Cortex-M0+) over its on-board ST-LINK: RAM-buffer recorder stream + live statistical profile by DWT_PCSR polling (this core has no ITM/SWO, so PC sampling by polling is the hardware-trace path). The imu.* user traces pair with the com.bkpt.demo.imu Trace Domain descriptor. ELF is not a .vacf key: set ELF / Symbols > ELF File to build/rambuf/Nucleo_C071_VA.elf for function names.",
  "transport": "stlink-rambuf",
  "target-device": "STM32C071RB",
  "interface": "SWD",
  "speed-khz": 4000,
  "cpu-clock-hz": 48000000,
  "rambuf-scan-start": "0x20000000",
  "rambuf-scan-size": 24576,
  "hardware-trace": {
    "dwt": { "enable": true, "pc-sample-cyc": 1 }
  }
}
